sus_ext = {
    ".exe" ,  
    ".dll",
    ".ps1", 
    ".bat",
    ".vbs",
}

filesize = 50 * 1024  * 1024    

#functions
def scan_file(path):
    results = []

    if not os.path.isfile(path):
        print("Error: path does not exist or is not a file.")
        return

    ext = os.path.splitext(path)[1].lower()
    if ext in sus_ext:
        results.append(f"suspicious ext: {ext}")

    try:
        size = os.path.getsize(path)
        if size > filesize:
            results.append("file too large to scan safely")
            print("potentially suspicious file:" )
            for f in results:
                print(f"  - {f}")
            return
    except OSError as e:
        print(f"Could not stat file: {e}" ) 
        return

    try:
        with open(path, "rb") as f:
            filename = f.read().lower()
            for keyword in sus_words:
                if keyword in filename:
                    results.append( f"suspicious keyword: {keyword.decode('utf-8', 'ignore')}")
    except OSError as e:
        results.append(f"could not read file: {e}")

    if results:
        print("potentially suspicious file:" )
        for f_item in results:
            print(f"  - {f_item}")
    else:
        print( "nothing suspicious found  ")

